<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_dominos_rfm_pivot" model="ir.ui.view">
        <field name="name">res.partner.dominos.rfm.pivot</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <pivot string="Báo cáo RFM">
                <field name="x_dom_rfm_segment" type="row"/>
                <field name="x_dom_rfm_total_spent" type="measure"/>
                <field name="x_dom_rfm_order_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_partner_dominos_rfm_graph" model="ir.ui.view">
        <field name="name">res.partner.dominos.rfm.graph</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph string="Biểu đồ Phân khúc RFM" type="bar">
                <field name="x_dom_rfm_segment"/>
                <field name="x_dom_rfm_total_spent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_dominos_rfm_report" model="ir.actions.act_window">
        <field name="name">Báo cáo RFM</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="domain">[('x_dom_rfm_segment', '!=', False)]</field>
    </record>

    <menuitem id="menu_dominos_rfm_report"
              name="Báo cáo RFM"
              parent="sale.menu_sale_report"
              action="action_dominos_rfm_report"
              sequence="50"/>
</odoo>